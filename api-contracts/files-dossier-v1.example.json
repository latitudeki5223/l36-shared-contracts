  "claims": [
    { "id": "c-001", "text": "In 1950–51 wool accounted for more than half of Australia's export income.", "claim_type": "fact",
      "source_url": "https://www.abs.gov.au/example/year-book-1953", "source_domain": "abs.gov.au", "source_type": "statistic",
      "published_at": "1953-01-01", "retrieved_at": "2026-09-10T02:14:00Z", "credibility": 0.95 },
    { "id": "c-002", "text": "The 1951 wool boom followed US stockpiling during the Korean War.", "claim_type": "interpretation",
      "source_url": "https://trove.nla.gov.au/example/article/1951", "source_domain": "trove.nla.gov.au", "source_type": "newspaper",
      "published_at": "1951-03-12", "retrieved_at": "2026-09-10T02:16:00Z", "credibility": 0.8,
      "attribution": "contemporary reporting in the Sydney Morning Herald" },
    { "id": "c-003", "text": "The Reserve Price Scheme began operating in 1974.", "claim_type": "fact",
      "source_url": "https://www.legislation.gov.au/example/wool-industry-act-1974", "source_domain": "legislation.gov.au", "source_type": "filing",
      "published_at": "1974-01-01", "retrieved_at": "2026-09-10T02:20:00Z", "credibility": 0.97 },
    { "id": "c-004", "text": "Under the scheme the Australian Wool Corporation bought any wool that failed to reach the floor price at auction.", "claim_type": "fact",
      "source_url": "https://trove.nla.gov.au/example/article/1975", "source_domain": "trove.nla.gov.au", "source_type": "newspaper",
      "published_at": "1975-08-02", "retrieved_at": "2026-09-10T02:21:00Z", "credibility": 0.9 },
    { "id": "c-005", "text": "By early 1991 the stockpile exceeded 4.7 million bales.", "claim_type": "fact",
      "source_url": "https://trove.nla.gov.au/example/article/1991-stockpile", "source_domain": "trove.nla.gov.au", "source_type": "newspaper",
      "published_at": "1991-02-12", "retrieved_at": "2026-09-10T02:25:00Z", "credibility": 0.9 },
    { "id": "c-006", "text": "The 1988 floor-price rise to 870 cents a kilogram was the decisive over-reach.", "claim_type": "disputed",
      "source_url": "https://example-university.edu.au/example/wool-crash-analysis", "source_domain": "example-university.edu.au", "source_type": "academic",
      "published_at": "2004-06-01", "retrieved_at": "2026-09-10T02:30:00Z", "credibility": 0.75,
      "attribution": "economic historians vs. industry figures of the time",
      "contest": "Industry representatives argued the collapse was driven by the Soviet and Chinese buying slump, not the floor level.",
      "secondary_source_urls": ["https://trove.nla.gov.au/example/article/1991-industry-response"] },
    { "id": "c-007", "text": "The Reserve Price Scheme was suspended on 11 February 1991.", "claim_type": "fact",
      "source_url": "https://trove.nla.gov.au/example/article/1991-02-11", "source_domain": "trove.nla.gov.au", "source_type": "newspaper",
      "published_at": "1991-02-11", "retrieved_at": "2026-09-10T02:33:00Z", "credibility": 0.95 },
    { "id": "c-008", "text": "\"We went to bed with a floor under us and woke up with nothing.\"", "claim_type": "eyewitness",
      "source_url": "https://oralhistory.example.gov.au/example/wool-growers-1992", "source_domain": "oralhistory.example.gov.au", "source_type": "oral_history",
      "published_at": "1992-05-01", "retrieved_at": "2026-09-10T02:35:00Z", "credibility": 0.8,
      "attribution": "a Riverina wool grower, recorded 1992" }
  ],

